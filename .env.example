# 이 파일을 복사해서 .env.local 로 만들고 값을 채워 넣으세요.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# 공고 분석 AI — 둘 중 하나만 있으면 돼요 (둘 다 있으면 Gemini 우선)
# [무료] https://aistudio.google.com/apikey 에서 발급 (카드 등록 불필요)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# [유료] https://console.anthropic.com > API Keys
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-haiku-4-5

# 선택: Jina Reader 키 (없어도 동작, 많이 쓰면 넣기)
# JINA_API_KEY=

# ── 휴대폰 알림 (선택) ──
# 터미널에서 `npx web-push generate-vapid-keys` 로 키 한 쌍 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Supabase > Project Settings > API Keys 의 Secret key (sb_secret_...). 서버 전용, 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=
# 매일 마감 알림 예약 작업 보호용. 아무 긴 랜덤 문자열
CRON_SECRET=
